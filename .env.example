# Copy to .env and fill in. Never commit .env.
# MongoDB Atlas connection string (include the database name at the end).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/govinnovate?retryWrites=true&w=majority

# Optional override for the database name (defaults to the one in MONGODB_URI).
# MONGODB_DB=govinnovate

# Session signing secret. REQUIRED in production (the app refuses to boot
# with the dev default). Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-value

# Rate-limit store: "memory" (default, single instance) or "mongo"
# (shared across instances via the audit database).
# RATE_LIMIT_STORE=memory

# Set to "true" only if you intentionally want `npm run seed` to wipe the
# database it points at. The seed script refuses production otherwise.
# ALLOW_DESTRUCTIVE_SEED=false
